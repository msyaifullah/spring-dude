## 3. Multi-Strategy Elasticsearch Query Builder

Six strategies in a single `bool` query, each boosted differently:

```java
// Requires Elasticsearch Java client (co.elastic.clients)
private Query buildNameQuery(String fullName) {
  NameNormalizer normalizer = new NameNormalizer();
  String normalizedName = normalizer.normalize(fullName);
  String noSpaceName    = normalizer.removeSpaces(fullName);
  List<String> tokens   = normalizer.tokenize(fullName);

  return Query.of(q -> q.bool(b -> {
    BoolQuery.Builder builder = new BoolQuery.Builder();

    // Strategy 1: Best-fields multi-match (order-agnostic, boost 3.0)
    builder.should(s -> s.multiMatch(m -> m
        .fields("full_name", "full_name.no_space")
        .query(normalizedName)
        .type(TextQueryType.BestFields)
        .boost(3.0f)));

    // Strategy 2: No-space exact match (boost 2.5)
    builder.should(s -> s.match(m -> m
        .field("full_name.no_space")
        .query(noSpaceName)
        .boost(2.5f)));

    // Strategy 3: Reversed token order (boost 2.8 normal, 2.3 no-space)
    if (tokens.size() >= 2) {
      List<String> rev = new ArrayList<>(tokens);
      Collections.reverse(rev);
      String reversedOrder   = String.join(" ", rev);
      String reversedNoSpace = String.join("", rev);

      builder.should(s -> s.multiMatch(m -> m
          .fields("full_name", "full_name.no_space")
          .query(reversedOrder)
          .type(TextQueryType.BestFields)
          .boost(2.8f)));

      builder.should(s -> s.match(m -> m
          .field("full_name.no_space")
          .query(reversedNoSpace)
          .boost(2.3f)));
    }

    // Strategy 4: Individual token matching — handles middle-name omission (boost 1.5 each)
    for (String token : tokens) {
      builder.should(s -> s.match(m -> m
          .field("full_name")
          .query(token)
          .boost(1.5f)));
    }

    // Strategy 5: Single no-space token — try splitting at midpoint variants (boost 2.0)
    if (tokens.size() == 1 && tokens.get(0).length() > 8) {
      String single = tokens.get(0);
      int len = single.length();
      int[] splits = { len / 2, Math.max(4, len / 2 - 2), Math.min(len - 4, len / 2 + 2) };

      for (int sp : splits) {
        if (sp >= 4 && sp <= len - 4) {
          String p1 = single.substring(0, sp);
          String p2 = single.substring(sp);

          // Both parts must match (order-agnostic)
          builder.should(s -> s.bool(b2 -> b2
              .must(m1 -> m1.match(m -> m.field("full_name").query(p1)))
              .must(m2 -> m2.match(m -> m.field("full_name").query(p2)))
              .boost(2.0f)));

          // Reversed parts
          builder.should(s -> s.bool(b2 -> b2
              .must(m1 -> m1.match(m -> m.field("full_name").query(p2)))
              .must(m2 -> m2.match(m -> m.field("full_name").query(p1)))
              .boost(2.0f)));
        }
      }
    }

    // Strategy 6: Fuzzy match for typos (boost 1.0)
    builder.should(s -> s.match(m -> m
        .field("full_name")
        .query(normalizedName)
        .fuzziness("AUTO")
        .boost(1.0f)));

    builder.minimumShouldMatch("1");
    return builder;
  }));
}
```

