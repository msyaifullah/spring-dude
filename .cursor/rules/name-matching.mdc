# Asian Name Matching Pattern

A reusable pattern for matching passenger/user names across Asian and Western naming conventions. Handles:

- **Order-agnostic**: "Khoo Alex" matches "Alex Khoo Kah Yee"
- **No-space**: "lethithanh" matches "Le Thi Thanh"
- **Honorific stripping**: "Encik Ahmad" matches "Ahmad"
- **Patronyms**: "Ahmad bin Abdullah" treated correctly
- **Partial / middle-name omission**: "Chen Alex" matches "Chen Kah Yee Alex"
- **Fuzzy**: "Ahmadbin Ali" matches "Ahmad bin Ali"
- **Single-token split**: "HernandezWilliam" split at midpoint and matched as two tokens

---

## 1. NameNormalizer — Core Logic

```java
import java.text.Normalizer;
import java.util.*;
import java.util.regex.Pattern;
import java.util.stream.Collectors;

public class NameNormalizer {

  // Honorifics to strip before matching (Malay, Indian, Western, Islamic titles)
  private static final Set<String> HONORIFICS = Set.of(
      "encik", "puan", "cik", "tuan",
      "mr", "mrs", "ms", "miss", "dr", "prof",
      "bin", "binti", "bt", "b", "a/l", "a/p", "ap",
      "haji", "hajah", "hj", "datuk", "dato", "tan sri", "tun"
  );

  private static final Pattern SPECIAL_CHARS = Pattern.compile("[^a-z0-9\\s]");
  private static final Pattern MULTIPLE_SPACES = Pattern.compile("\\s+");

  /** Lowercase, strip accents, remove special chars, strip honorifics */
  public String normalize(String fullName) {
    if (fullName == null || fullName.isBlank()) return "";

    String s = fullName.trim().toLowerCase().replace(".", " ").replace(",", " ");
    s = Normalizer.normalize(s, Normalizer.Form.NFD);   // decompose accents
    s = SPECIAL_CHARS.matcher(s).replaceAll(" ");
    s = MULTIPLE_SPACES.matcher(s).replaceAll(" ");
    s = removeHonorifics(s);
    return s.trim();
  }

  /** Split normalized name into individual tokens */
  public List<String> tokenize(String fullName) {
    return Arrays.stream(normalize(fullName).split("\\s+"))
        .filter(t -> !t.isEmpty())
        .collect(Collectors.toList());
  }

  /** Remove all spaces from normalized name (for no-space matching) */
  public String removeSpaces(String fullName) {
    return normalize(fullName).replaceAll("\\s+", "");
  }

  /**
   * Jaccard token similarity.
   * Returns 1.0 for exact no-space match, otherwise intersection/union of tokens.
   */
  public double calculateSimilarity(String name1, String name2) {
    String ns1 = removeSpaces(name1);
    String ns2 = removeSpaces(name2);
    if (ns1.equals(ns2) && !ns1.isEmpty()) return 1.0;

    Set<String> t1 = new HashSet<>(tokenize(name1));
    Set<String> t2 = new HashSet<>(tokenize(name2));

    if (t1.isEmpty() || t2.isEmpty()) return 0.0;

    // Single no-space token vs multi-token: "lethithanh" == "le thi thanh"
    if (t1.size() == 1 && t2.size() > 1) {
      if (t1.iterator().next().equals(String.join("", t2))) return 1.0;
    }
    if (t2.size() == 1 && t1.size() > 1) {
      if (t2.iterator().next().equals(String.join("", t1))) return 1.0;
    }

    Set<String> intersection = new HashSet<>(t1);
    intersection.retainAll(t2);
    Set<String> union = new HashSet<>(t1);
    union.addAll(t2);

    return (double) intersection.size() / union.size();
  }

  private String removeHonorifics(String name) {
    return Arrays.stream(name.split("\\s+"))
        .filter(token -> !HONORIFICS.contains(token.toLowerCase()))
        .collect(Collectors.joining(" "));
  }
}
```

